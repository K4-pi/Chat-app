<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Chat.MainWindow"
    Title="Chat"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Chat"
    xmlns:models="using:Chat.DataModels">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="My Rooms" Grid.Row="0" 
               FontSize="18" HorizontalAlignment="Center" 
               FontWeight="SemiBold" Margin="0,0,0,10" 
               Style="{StaticResource SubtitleTextBlockStyle}"/>

            <ListView x:Name="RoomList" Grid.Row="1" CornerRadius="4"
              BorderBrush="Gray" BorderThickness="5"
              SelectionChanged="RoomList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatRoom">
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,5,0,0">
                            <Button x:Name="DeleteRoomButton" Margin="0,0,5,0" Content="❌" Click="DeleteRoomButton_Click" Style="{StaticResource AccentButtonStyle}"/>
                            <StackPanel Orientation="Vertical" Spacing="1">
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="{x:Bind Code}" VerticalAlignment="Center" Foreground="Gray"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button x:Name="CreateRoomButton" Content="Create Room" Grid.Row="2" 
            HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="CreateRoomButton_Click" Style="{StaticResource AccentButtonStyle}"/>

            <Button x:Name="JoinRoomButton" Content="Join Room" Grid.Row="3" 
            HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="JoinRoomButton_Click" Style="{StaticResource AccentButtonStyle}"/>

            <Button x:Name="LogoutButton" Content="Logout" Grid.Row="4" 
            HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="LogoutButton_Click" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Users Online" FontSize="18" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,10" Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}"/>

            <ScrollViewer x:Name="UserScrollViewer"
              Grid.Row="1" 
              VerticalScrollBarVisibility="Auto"
              VerticalScrollMode="Enabled"
              BorderThickness="5" 
              BorderBrush="Gray"
              CornerRadius="4"
              Padding="5">

                <ItemsRepeater x:Name="UsersList"
                   ItemsSource="{x:Bind UsersInRoom}" 
                   HorizontalAlignment="Stretch">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:User">
                            <Grid Padding="8,4" Margin="2" Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Ellipse Width="32" Height="32" Fill="{ThemeResource SystemColorControlAccentColor}"/>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Username}" 
                                       FontWeight="SemiBold" 
                                       FontSize="14"/>
                                        <TextBlock Text="Online" 
                                       FontSize="10" 
                                       Foreground="ForestGreen"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="2"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <ScrollViewer x:Name="MessageScrollViewer"
              Grid.Row="0" Grid.Column="1" 
              VerticalScrollBarVisibility="Auto"
              VerticalScrollMode="Enabled"
              BorderThickness="5" 
              BorderBrush="Gray"
              CornerRadius="4"
              Padding="5"
              Margin="0,0,0,10">
            <ItemsRepeater x:Name="MessageList"
                   ItemsSource="{x:Bind Messages}"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:Message">
                        <Grid Margin="10,5" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="2" MaxWidth="500" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Username}" 
                                       FontWeight="Bold" 
                                       FontSize="12" 
                                       IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource SystemColorControlAccentColor}"/>
                                    <TextBlock Text="{x:Bind SentAt}" 
                                       FontSize="10" 
                                       VerticalAlignment="Bottom" 
                                       Foreground="Gray"/>
                                </StackPanel>
                                <Border Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}" 
                                CornerRadius="8" 
                                Padding="12,8">
                                    <TextBlock Text="{x:Bind Text}" 
                                       TextWrapping="Wrap" 
                                       IsTextSelectionEnabled="True"
                                       FontSize="14"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageInput" IsSpellCheckEnabled="False" PlaceholderText="Type a message..." VerticalAlignment="Center" KeyDown="MessageInput_KeyDown"/>
            <Button x:Name="SendButton" Content="Send" Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                Margin="10,0,0,0" VerticalAlignment="Center" Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
