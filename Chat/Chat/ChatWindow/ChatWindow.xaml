<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Chat.MainWindow"
    Title="Chat"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Chat"
    xmlns:models="using:Chat.DataModels">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>

        <!-- Rooms List -->
        <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="My Rooms" Grid.Row="0"
                       FontSize="15" HorizontalAlignment="Center"
                       FontWeight="SemiBold" Margin="0,0,0,8"
                       Style="{StaticResource SubtitleTextBlockStyle}"/>

            <ListView x:Name="RoomList" Grid.Row="1"
                      CornerRadius="6"
                      BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                      BorderThickness="1"
                      SelectionChanged="RoomList_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatRoom">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DeleteRoomButton"
                                    Grid.Column="0"
                                    Width="22" Height="22"
                                    Padding="0"
                                    CornerRadius="4"
                                    Content="&#xE711;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="11"
                                    Click="DeleteRoomButton_Click"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="1">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{x:Bind Code}" FontSize="11"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button x:Name="CreateRoomButton" Content="Create Room" Grid.Row="2"
                    HorizontalAlignment="Stretch" Margin="0,8,0,0"
                    CornerRadius="6"
                    Click="CreateRoomButton_Click" Style="{StaticResource AccentButtonStyle}"/>

            <Button x:Name="JoinRoomButton" Content="Join Room" Grid.Row="3"
                    HorizontalAlignment="Stretch" Margin="0,6,0,0"
                    CornerRadius="6"
                    Click="JoinRoomButton_Click" Style="{StaticResource AccentButtonStyle}"/>

            <Button x:Name="SettingsButton" Content="Settings" Grid.Row="4"
                    HorizontalAlignment="Stretch" Margin="0,6,0,0"
                    CornerRadius="6"
                    Click="SettingsButton_Click"/>

            <Button x:Name="LogoutButton" Content="Logout" Grid.Row="5"
                    HorizontalAlignment="Stretch" Margin="0,6,0,0"
                    CornerRadius="6"
                    Click="LogoutButton_Click"/>
        </Grid>

        <!-- Users List -->
        <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Users Online" FontSize="15" HorizontalAlignment="Center"
                       FontWeight="SemiBold" Margin="0,0,0,8" Grid.Row="0"
                       Style="{StaticResource SubtitleTextBlockStyle}"/>

            <ScrollViewer x:Name="UserScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Enabled"
                          BorderThickness="1"
                          BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                          CornerRadius="6"
                          Padding="6">
                <ItemsRepeater x:Name="UsersList"
                               ItemsSource="{x:Bind UsersInRoom}"
                               HorizontalAlignment="Stretch">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:User">
                            <Grid Padding="8,5" Margin="0,0,0,3"
                                  Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}"
                                  CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Grid Width="30" Height="30">
                                        <Ellipse Width="30" Height="30"
                                                 Fill="{ThemeResource SystemColorControlAccentColor}"/>
                                        <TextBlock Text="{x:Bind Username}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Username}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Online" FontSize="10"
                                                   Foreground="#22A85A"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="2"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <!-- Messages -->
        <ScrollViewer x:Name="MessageScrollViewer"
                      Grid.Row="0" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                      CornerRadius="6"
                      Padding="10"
                      Margin="0,0,0,8">
            <ItemsRepeater x:Name="MessageList"
                           ItemsSource="{x:Bind Messages}"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:Message">
                        <Grid Margin="0,4" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="3" MaxWidth="500" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Username}"
                                               FontWeight="SemiBold" FontSize="12"
                                               IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource SystemColorControlAccentColor}"/>
                                    <TextBlock Text="{x:Bind SentAt}"
                                               FontSize="10" VerticalAlignment="Bottom"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>
                                <Border Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                                        BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,7">
                                    <TextBlock Text="{x:Bind Text}"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True"
                                               FontSize="13"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="2"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Input -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageInput"
                     IsSpellCheckEnabled="False"
                     PlaceholderText="Type a message..."
                     VerticalAlignment="Center"
                     CornerRadius="6"
                     KeyDown="MessageInput_KeyDown"/>
            <Button x:Name="SendButton" Content="Send"
                    Grid.Column="1"
                    Style="{StaticResource AccentButtonStyle}"
                    CornerRadius="6"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>