<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Chat.MainWindow"
    Title="Chat"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <ListView x:Name="MessageList" Grid.Row="0" Grid.Column="0"
                  BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1" Margin="0,0,10,10">
        </ListView>

        <ListView x:Name="UserList" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                  Header="Users Online"
                  BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1">
        </ListView>

        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="MessageInput" PlaceholderText="Type a message..."
                     VerticalAlignment="Center"/>
            <Button x:Name="SendButton" Content="Send" Grid.Column="1"
                    Margin="10,0,0,0" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
