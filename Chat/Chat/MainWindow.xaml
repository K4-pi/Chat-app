<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Chat.MainWindow"
    Title="Chat"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Chat">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="My Rooms" FontSize="18" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,10" Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}"/>

            <ListView x:Name="RoomList" Grid.Row="1" CornerRadius="4"
              BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="5"
              SelectionChanged="RoomList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ChatRoom">
                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" Padding="5"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button x:Name="CreateRoomButton" Content="Create Room" Grid.Row="2" 
            HorizontalAlignment="Stretch" Margin="0,10,0,0" Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="JoinRoomButton" Content="Join Private" Grid.Row="3" 
            HorizontalAlignment="Stretch" Margin="0,5,0,0" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Users Online" FontSize="18" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,10" Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}"/>

            <ListView x:Name="UserList" Grid.Row="1" CornerRadius="4"
              BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="5">
            </ListView>

            <Button x:Name="AddFriendButton" Content="Add Friend" Grid.Row="2" 
                HorizontalAlignment="Stretch" Margin="0,10,0,0" Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="LogoutButton" Content="Logout" Grid.Row="3" 
                HorizontalAlignment="Stretch" Margin="0,5,0,0" Click="LogoutButton_Click" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <ScrollViewer x:Name="MessageScrollViewer" 
              Grid.Row="0" Grid.Column="1" 
              VerticalScrollBarVisibility="Auto"
              VerticalScrollMode="Enabled">
            <ItemsRepeater x:Name="MessageList" 
                   ItemsSource="{x:Bind Messages}"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:Message">
                        <Grid Margin="10,5" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="2" MaxWidth="500" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Username}" 
                                       FontWeight="Bold" 
                                       FontSize="12" 
                                       IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource SystemColorControlAccentColor}"/>
                                    <TextBlock Text="{x:Bind SentAt}" 
                                       FontSize="10" 
                                       VerticalAlignment="Bottom" 
                                       Foreground="Gray"/>
                                </StackPanel>
                                <Border Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}" 
                                CornerRadius="8" 
                                Padding="12,8">
                                    <TextBlock Text="{x:Bind Text}" 
                                       TextWrapping="Wrap" 
                                       IsTextSelectionEnabled="True"
                                       FontSize="14"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageInput" PlaceholderText="Type a message..." VerticalAlignment="Center"/>
            <Button x:Name="SendButton" Content="Send" Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                Margin="10,0,0,0" VerticalAlignment="Center" Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
