<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Chat.MainWindow"
    Title="Chat"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Chat">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="My Rooms" FontSize="18" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,10" Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}"/>

            <ListView x:ConnectionId='13' x:Name="RoomList" Grid.Row="1" CornerRadius="4"
              BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="5"
                                                          >
                <ListView.ItemTemplate>
                    <DataTemplate                            >
                        <TextBlock x:ConnectionId='17'                      VerticalAlignment="Center" Padding="5"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button x:ConnectionId='14' x:Name="CreateRoomButton" Content="Create Room" Grid.Row="2" 
            HorizontalAlignment="Stretch" Margin="0,10,0,0" Style="{StaticResource AccentButtonStyle}"/>
            <Button x:ConnectionId='15' x:Name="JoinRoomButton" Content="Join Private" Grid.Row="3" 
            HorizontalAlignment="Stretch" Margin="0,5,0,0" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Users Online" FontSize="18" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,10" Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}"/>

            <ListView x:ConnectionId='10' x:Name="UserList" Grid.Row="1" CornerRadius="4"
              BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="5">
            </ListView>

            <Button x:ConnectionId='11' x:Name="AddFriendButton" Content="Add Friend" Grid.Row="2" 
                HorizontalAlignment="Stretch" Margin="0,10,0,0" Style="{StaticResource AccentButtonStyle}"/>
            <Button x:ConnectionId='12' x:Name="LogoutButton" Content="Logout" Grid.Row="3" 
                HorizontalAlignment="Stretch" Margin="0,5,0,0"                            Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <ListView x:ConnectionId='2' x:Name="MessageList" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" CornerRadius="4"
                  BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="5">
            <ListView.ItemTemplate>
                <DataTemplate                           >
                    <StackPanel x:ConnectionId='6' Margin="0,4">
                        <TextBlock x:ConnectionId='7'                          FontWeight="Bold" Foreground="Blue"/>
                        <TextBlock x:ConnectionId='8'                      TextWrapping="Wrap"/>
                        <TextBlock x:ConnectionId='9'                        FontSize="10" Foreground="Gray" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:ConnectionId='3' x:Name="MessageInput" PlaceholderText="Type a message..." VerticalAlignment="Center"/>
            <Button x:ConnectionId='4' x:Name="SendButton" Content="Send" Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                Margin="10,0,0,0" VerticalAlignment="Center"                         />
        </Grid>
    </Grid>
</Window>

