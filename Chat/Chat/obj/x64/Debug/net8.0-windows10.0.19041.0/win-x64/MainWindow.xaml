<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Chat.MainWindow"
    Title="Chat"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Chat">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>

        <ListView x:ConnectionId='2' x:Name="RoomList" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
              Header="My Rooms" Margin="0,0,10,0"
              BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
                                                          >
            <ListView.ItemTemplate>
                <DataTemplate                            >
                    <TextBlock x:ConnectionId='13'                      VerticalAlignment="Center" Padding="5"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ListView x:ConnectionId='3' x:Name="MessageList" Grid.Row="0" Grid.Column="1">
            <ListView.ItemTemplate>
                <DataTemplate                           >
                    <StackPanel x:ConnectionId='8' Margin="0,4">
                        <TextBlock x:ConnectionId='9'                          FontWeight="Bold" Foreground="Blue"/>
                        <TextBlock x:ConnectionId='10'                      TextWrapping="Wrap"/>
                        <TextBlock x:ConnectionId='11'                        FontSize="10" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ListView x:ConnectionId='4' x:Name="UserList" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
              Header="Users Online"
              BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1">
        </ListView>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:ConnectionId='5' x:Name="MessageInput" PlaceholderText="Type a message..." VerticalAlignment="Center"/>
            <Button x:ConnectionId='6' x:Name="SendButton" Content="Send" Grid.Column="1"
                Margin="10,0,0,0" VerticalAlignment="Center"                         />
        </Grid>
    </Grid>
</Window>

