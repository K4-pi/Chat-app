<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Chat.LoginWindow"
    Title="Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
		<StackPanel Spacing="18">
			<TextBlock x:ConnectionId='2' x:Name="WelcomeText" Text="Welcome" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>

            <TextBox x:ConnectionId='3' x:Name="UsernameField" TextAlignment="Center" Header="Username" PlaceholderText="Enter username"/>
            <PasswordBox x:ConnectionId='4' x:Name="PasswordField" PasswordRevealMode="Peek" Header="Password" PlaceholderText="Enter password"/>

			<Button x:ConnectionId='5' x:Name="LoginButton" Content="Login"
                    HorizontalAlignment="Stretch"
                                             
                    Style="{StaticResource AccentButtonStyle}"/>

            <HyperlinkButton x:ConnectionId='6' Content="Sign up!"
                                     
                 Padding="0" 
                 HorizontalAlignment="Center"          
                 Margin="0,5,0,0"/>

            <TextBlock x:ConnectionId='7' x:Name="ErrorLoginText" Text="" FontSize="12" FontWeight="Normal" HorizontalAlignment="Center" Foreground="Red"/>
        </StackPanel>
	</Grid>
</Window>

