<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Chat.LoginWindow"
    Title="Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
		<StackPanel Spacing="15">
			<TextBlock Text="Welcome" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>

			<TextBox x:ConnectionId='2' x:Name="UsernameField" Header="Username" PlaceholderText="Enter username"/>
			<PasswordBox x:ConnectionId='3' x:Name="PasswordField" Header="Password" PlaceholderText="Enter password"/>

			<Button x:ConnectionId='4' x:Name="LoginButton" Content="Login"
                    HorizontalAlignment="Stretch"
                                             
                    Style="{StaticResource AccentButtonStyle}"/>
		</StackPanel>
	</Grid>
</Window>

