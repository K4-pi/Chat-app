<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Chat.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Chat"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
        <StackPanel Spacing="18">
            <TextBlock x:ConnectionId='2' x:Name="WelcomeText" Text="Create account" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>

            <TextBox x:ConnectionId='3' x:Name="UsernameField" Header="Username" PlaceholderText="Enter username"/>
            <PasswordBox x:ConnectionId='4' x:Name="PasswordField" Header="Password" PlaceholderText="Enter password"/>

            <Button x:ConnectionId='5' x:Name="RegisterButton" Content="Sign up"
                HorizontalAlignment="Stretch"
                                            
                Style="{StaticResource AccentButtonStyle}"/>

            <HyperlinkButton x:ConnectionId='6' Content="Sign in!"
                                 
             Padding="0" 
             HorizontalAlignment="Center"          
             Margin="0,5,0,0"/>

            <TextBlock x:ConnectionId='7' x:Name="ErrorLoginText" Text="" FontSize="12" FontWeight="Normal" HorizontalAlignment="Center" Foreground="Red"/>
        </StackPanel>
    </Grid>
</Page>

