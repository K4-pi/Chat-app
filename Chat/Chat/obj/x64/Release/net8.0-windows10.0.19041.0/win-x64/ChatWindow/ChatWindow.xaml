<?xml version="1.0" encoding="utf-8"?>
<Window x:ConnectionId='1'
    x:Class="Chat.MainWindow"
    Title="Chat"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Chat"
    xmlns:models="using:Chat.DataModels">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Rooms -->
        <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="My Rooms" Grid.Row="0"
                       FontSize="15" HorizontalAlignment="Center"
                       FontWeight="SemiBold" Margin="0,0,0,8"
                       Style="{StaticResource SubtitleTextBlockStyle}"/>

            <ListView x:ConnectionId='17' x:Name="RoomList" Grid.Row="1"
                      CornerRadius="6"
                      BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                      BorderThickness="1"
                                                                  >
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate                             >
                        <Grid x:ConnectionId='23' ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:ConnectionId='24' x:Name="DeleteRoomButton"
                                    Grid.Column="0"
                                    Width="22" Height="22"
                                    Padding="0"
                                    CornerRadius="4"
                                    Content="&#xE711;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="11"
                                                                  />
                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="1">
                                <TextBlock x:ConnectionId='25'                      FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:ConnectionId='26'                      FontSize="11"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button x:ConnectionId='18' x:Name="CreateRoomButton" Content="Create Room" Grid.Row="2"
                    HorizontalAlignment="Stretch" Margin="0,8,0,0"
                    CornerRadius="6"
                                                   Style="{StaticResource AccentButtonStyle}"/>

            <Button x:ConnectionId='19' x:Name="JoinRoomButton" Content="Join Room" Grid.Row="3"
                    HorizontalAlignment="Stretch" Margin="0,6,0,0"
                    CornerRadius="6"
                                                 Style="{StaticResource AccentButtonStyle}"/>

            <Button x:ConnectionId='20' x:Name="SettingsButton" Content="Settings" Grid.Row="4"
                    HorizontalAlignment="Stretch" Margin="0,6,0,0"
                    CornerRadius="6"
                                                />

            <Button x:ConnectionId='21' x:Name="LogoutButton" Content="Logout" Grid.Row="5"
                    HorizontalAlignment="Stretch" Margin="0,6,0,0"
                    CornerRadius="6"
                                              />
        </Grid>

        <!-- Right: Users Online -->
        <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Users Online" FontSize="15" HorizontalAlignment="Center"
                       FontWeight="SemiBold" Margin="0,0,0,8" Grid.Row="0"
                       Style="{StaticResource SubtitleTextBlockStyle}"/>

            <ScrollViewer x:ConnectionId='11' x:Name="UserScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Enabled"
                          BorderThickness="1"
                          BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                          CornerRadius="6"
                          Padding="6">
                <ItemsRepeater x:ConnectionId='12' x:Name="UsersList"
                                                                 
                               HorizontalAlignment="Stretch">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate                         >
                            <Grid x:ConnectionId='14' Padding="8,5" Margin="0,0,0,3"
                                  Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}"
                                  CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Grid Width="30" Height="30">
                                        <Ellipse Width="30" Height="30"
                                                 Fill="{ThemeResource SystemColorControlAccentColor}"/>
                                        <TextBlock x:ConnectionId='16'                         
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock x:ConnectionId='15'                         
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Online" FontSize="10"
                                                   Foreground="#22A85A"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="2"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <!-- Center: Messages -->
        <ScrollViewer x:ConnectionId='2' x:Name="MessageScrollViewer"
                      Grid.Row="0" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                      CornerRadius="6"
                      Padding="10"
                      Margin="0,0,0,8">
            <ItemsRepeater x:ConnectionId='5' x:Name="MessageList"
                                                          
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate                            >
                        <Grid x:ConnectionId='7' Margin="0,4" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="3" MaxWidth="500" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:ConnectionId='9'                         
                                               FontWeight="SemiBold" FontSize="12"
                                               IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource SystemColorControlAccentColor}"/>
                                    <TextBlock x:ConnectionId='10'                       
                                               FontSize="10" VerticalAlignment="Bottom"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>
                                <Border Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                                        BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,7">
                                    <TextBlock x:ConnectionId='8'                     
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True"
                                               FontSize="13"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="2"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Bottom: Input -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:ConnectionId='3' x:Name="MessageInput"
                     IsSpellCheckEnabled="False"
                     PlaceholderText="Type a message..."
                     VerticalAlignment="Center"
                     CornerRadius="6"
                                                   />
            <Button x:ConnectionId='4' x:Name="SendButton" Content="Send"
                    Grid.Column="1"
                    Style="{StaticResource AccentButtonStyle}"
                    CornerRadius="6"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                                            />
        </Grid>
    </Grid>
</Window>

