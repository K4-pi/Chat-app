<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ChatApp"
        x:Class="ChatApp.MainWindow"
        Title="Chat"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="My Rooms" FontSize="18" HorizontalAlignment="Center" 
                       FontWeight="SemiBold" Margin="0,0,0,10" Grid.Row="0"/>

            <ListBox x:Name="RoomList" Grid.Row="1" CornerRadius="4"
                     BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                     BorderThickness="2"
                     SelectionChanged="RoomList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ChatRoom">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Padding="5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button x:Name="CreateRoomButton" Content="Create Room" Grid.Row="2"
                    HorizontalAlignment="Stretch" Margin="0,10,0,0" Classes="accent"/>
            <Button x:Name="JoinRoomButton" Content="Join Private" Grid.Row="3"
                    HorizontalAlignment="Stretch" Margin="0,5,0,0"/>
        </Grid>

        <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Users Online" FontSize="18" HorizontalAlignment="Center" 
                       FontWeight="SemiBold" Margin="0,0,0,10" Grid.Row="0"/>

            <ListBox x:Name="UserList" Grid.Row="1" CornerRadius="4"
                     BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                     BorderThickness="2">
            </ListBox>

            <Button x:Name="AddFriendButton" Content="Add Friend" Grid.Row="2"
                    HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
            <Button x:Name="LogoutButton" Content="Logout" Grid.Row="3"
                    HorizontalAlignment="Stretch" Margin="0,5,0,0" 
                    Click="LogoutButton_Click" Classes="accent"/>
        </Grid>

        <ListBox x:Name="MessageList" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" CornerRadius="4"
                 BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                 BorderThickness="2">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:Message">
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding Username}" FontWeight="Bold" Foreground="#3498db"/>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SentAt}" FontSize="10" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageInput" Watermark="Type a message..." VerticalAlignment="Center"/>
            <Button x:Name="SendButton" Content="Send" Grid.Column="1" Classes="accent"
                    Margin="10,0,0,0" VerticalAlignment="Center" Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
